<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ou anterior. O app guarda dados pessoais e de motorista no aparelho;
     nada vai para a cópia de segurança (allowBackup="false" no manifest). -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
